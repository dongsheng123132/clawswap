# Monad Testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
PRIVATE_KEY=
ETHERSCAN_API_KEY=

# Services (use root .env; loaded by npm run dev via dotenv-cli)
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
# API base URL for frontend → server; use http://localhost:3001 for local dev
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server: allow CORS from this origin (frontend URL)
FRONTEND_URL=http://localhost:3000

# ZeroDev (Phase 3: AA wallet + gasless swap)
NEXT_PUBLIC_ZERODEV_PROJECT_ID=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Database (Neon PostgreSQL for Vercel)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/clawswap?sslmode=require"

# Vercel Cron: secret for /api/cron/agent (set in Vercel env)
CRON_SECRET=
